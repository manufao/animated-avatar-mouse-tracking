{
	"name": "animated-avatar-mouse-tracking",
	"version": "1.0.0",
	"private": true,
	"description": "Under construction page: a 2D avatar follows the mouse, blinks, gets bored and yawns, on Paris daylight time.",
	"license": "MIT",
	"author": "Emmanuel Maravilha",
	"type": "module",
	"packageManager": "pnpm@12.10.1",
	"engines": {
		"node": ">=22.12"
	},
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint . --max-warnings 0",
		"lint:fix": "eslint . --fix",
		"lint:deps": "depcruise src",
		"test:types": "tsc -p tsconfig.json",
		"test": "vitest",
		"test:ci": "vitest run --coverage",
		"security:audit": "pnpm audit --prod",
		"security:scan": "gitleaks detect --source . -v",
		"prepare": "husky",
		"test:tools": "cd outils && uv run ruff format --check . && uv run ruff check . && uv run pytest"
	},
	"lint-staged": {
		"*.js": [
			"prettier --write",
			"eslint --fix"
		],
		"*.{css,json,md,yaml,yml,html}": [
			"prettier --write"
		],
		"outils/**/*.py": [
			"uv run --project outils ruff format",
			"uv run --project outils ruff check --fix"
		]
	},
	"commitlint": {
		"extends": [
			"@commitlint/config-conventional"
		]
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@vitest/coverage-v8": "^5.0.5",
		"browserslist": "^4.29.5",
		"dependency-cruiser": "^18.7.0",
		"eslint": "^10.14.0",
		"eslint-plugin-import-x": "^4.17.1",
		"eslint-plugin-no-secrets": "^2.3.3",
		"eslint-plugin-security": "^4.2.1",
		"eslint-plugin-simple-import-sort": "^14.0.0",
		"eslint-plugin-unicorn": "^79.0.0",
		"globals": "^17.14.0",
		"husky": "^9.1.7",
		"jsdom": "^30.1.3",
		"lightningcss": "^1.33.0",
		"lint-staged": "^17.6.0",
		"prettier": "^3.9.10",
		"typescript": "^7.0.2",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	}
}
